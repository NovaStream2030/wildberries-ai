# HTTP server
HOST=127.0.0.1
PORT=8787

# WB session. Create it through the UI instead of putting secrets here.
# Default: $XDG_CONFIG_HOME/wildberries-ai/session.json (usually
# ~/.config/wildberries-ai/session.json). Legacy data/session.json is read
# when the new file does not exist.
# WB_JWT=
# WB_USER_DATA=
# WB_COOKIE=

# Optional: require this bearer token for writes to /api/config,
# /api/config/test and /api/sessions/reset. When set, it is required even on
# loopback (reverse proxies make remote clients look local). The web UI has an
# "Admin token" field for it.
# ADMIN_TOKEN=

# Extra browser origins allowed to call the API, comma-separated. The gateway's
# own localhost origins are always allowed. Add a LAN origin here if you open
# the UI via a LAN address. Never use "*".
# ALLOWED_ORIGINS=https://example.com

# Upstream endpoint (override for tests/mirrors). It receives your WB
# credentials; only change it if you trust the host.
# WB_UPSTREAM_URL=https://ai-proxy.wildberries.ru/ai-proxy/api/chat/v5/message

# How much system/history to inline into a fresh WB session.
# auto: inline only when the result fits WB_MAX_INLINE_CHARS
# inline: always inline; last: send only the last user message
# WB_PROMPT_MODE=auto
# WB_MAX_INLINE_CHARS=4000
